{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ness",
  "version": "0.1.0",
  "identifier": "com.pires.ness",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ness",
        "width": 960,
        "height": 640,
        "minWidth": 480,
        "minHeight": 360,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": ["'self'", "data:", "asset:", "http://asset.localhost"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "font-src": ["'self'", "data:"],
        "connect-src": ["ipc:", "http://ipc.localhost"]
      },
      "devCsp": {
        "default-src": "'self'",
        "img-src": ["'self'", "data:", "asset:", "http://asset.localhost"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "font-src": ["'self'", "data:"],
        "script-src": ["'self'", "'unsafe-inline'"],
        "connect-src": [
          "ipc:",
          "http://ipc.localhost",
          "ws://localhost:1420",
          "http://localhost:1420"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
